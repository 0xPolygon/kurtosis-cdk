{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed baseUrl, which @docusaurus/tsconfig still sets, so reset it and
    // resolve @site/* from this directory instead.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
