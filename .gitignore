# S11b T5: resolved enclave addresses and the T-l baseline, written by
# scripts/hyperpay-up.sh / scripts/hyperpay-check-handshake.sh. Per-run values
# (kurtosis host ports are ephemeral per enclave) -- never committed.
.hyperpay-addresses.env
.hyperpay-baseline.env
# S11b T7: the really-claimed total T8's withdrawal cap is read from, written by
# scripts/hyperpay-deposit-claim.sh. Enclave-scoped (it carries the enclave
# UUID); committing it would let a stale cap authorise a withdrawal larger than
# the value that actually entered, which is the permanent-wedge failure.
.hyperpay-claimed.env
# S11b step 4: the exit phase 3 made, so START_PHASE=4 resumes against THAT
# withdrawal instead of making a second one. Per-run and per-enclave: a stale
# deposit_count would send phase 5 to claim an exit this run never created.
.hyperpay-withdrawal.env

# S11b T8: hp-scenario's bridge-inbox funding ledger, per enclave. A reused
# seq_no is an IdempotentAck -- acked and silently never credited -- so this must
# persist across runs of one enclave and never be shared between enclaves.
.hyperpay-funding-*.json
.hyperpay-scenario/
